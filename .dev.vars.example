# Local development secrets for `npx wrangler dev`.
# Copy to `.dev.vars` (which is git-ignored) and fill in real values.
# Values here override [vars] in wrangler.toml locally, so use Stripe TEST keys.
# In production the secrets are set with `npx wrangler secret put …` instead.

MAILERSEND_API_KEY=

STRIPE_SECRET_KEY=sk_test_
# From `stripe listen --forward-to localhost:8080/api/stripe-webhook`
STRIPE_WEBHOOK_SECRET=whsec_
